# YouTube Video Summarizer — Backend Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit your .env file to GitHub — it contains secrets!
# -------------------------------------------------------

# Your Anthropic API key — get one at https://console.anthropic.com/
# It should start with: sk-ant-
ANTHROPIC_API_KEY=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

# Note: no YouTube API key needed. yt-dlp scrapes title/channel/duration
# directly when it downloads the audio, so we get metadata for free.

# Flask environment — use "development" locally, "production" on the server
FLASK_ENV=development

# Port the backend server runs on
# Note: macOS AirPlay uses port 5000, so we default to 5001 locally
PORT=5001

# URL of the frontend (used for CORS in development)
FRONTEND_URL=http://localhost:5173

# Set to "true" to skip real API calls and return stubbed responses
# Useful when developing the frontend or running CI without API credits
TEST_MODE=true

# Anthropic model — sonnet-4-6 is the default; haiku-4-5 is cheaper but less detailed
ANTHROPIC_MODEL=claude-sonnet-4-6
